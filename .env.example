# ============================================================================
# MEK ENGINEERING CORPORATION — ENVIRONMENT CONFIGURATION (mekengg.com)
# ============================================================================

# Production Site URL & Port
PORT=3600
NEXT_PUBLIC_SITE_URL=https://mekengg.com

# NextAuth v5 Configuration
# Generate a strong secret in production: openssl rand -base64 32
AUTH_SECRET=change-this-to-a-secure-random-32-byte-secret-in-production
AUTH_TRUST_HOST=true

# SQLite / libSQL Database Path (WAL concurrency mode enabled automatically)
DATABASE_PATH=./data/mekengineering.db
# Optional remote/custom libSQL URL override (leave unset for local file SQLite)
# LIBSQL_URL=file:./data/mekengineering.db
# LIBSQL_AUTH_TOKEN=

# Optional Environment Fallbacks for Cloudflare R2 & Nodemailer SMTP
# NOTE: Both R2 Connections (#1 and #2, including One-Click Cloudflare Connect)
# and Gmail SMTP credentials are stored & managed directly in SQLite via `/admin`!
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

R2_2_ACCOUNT_ID=
R2_2_ACCESS_KEY_ID=
R2_2_SECRET_ACCESS_KEY=
R2_2_BUCKET_NAME=
R2_2_PUBLIC_URL=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="Mek Engineering Corporation"
SMTP_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=info@mekengineering.com
